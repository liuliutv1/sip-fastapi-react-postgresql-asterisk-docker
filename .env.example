APP_NAME="Mini SIP Outbound Call Center"
APP_ENV=development

POSTGRES_DB=callcenter
POSTGRES_USER=callcenter
POSTGRES_PASSWORD=callcenter
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://callcenter:callcenter@postgres:5432/callcenter
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET_KEY=change-me-in-production
SIP_PASSWORD_ENCRYPTION_KEY=change-me-sip-password-encryption-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

BACKEND_PORT=8000
NGINX_PORT=8080
VITE_API_BASE_URL=/api
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

ASTERISK_IMAGE=asterisk/asterisk:20
ASTERISK_SIP_PORT=5060
ASTERISK_AMI_PUBLIC_PORT=5038
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10020
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=callcenter
ASTERISK_AMI_PASSWORD=callcenter
ASTERISK_ORIGINATE_TIMEOUT_MS=30000
SIP_VENDOR_IP=218.245.102.33
SIP_VENDOR_PORT=6876
SIP_TRUNK_NAME=outbound-trunk
MANUAL_OUTBOUND_RATE_LIMIT_COUNT=5
MANUAL_OUTBOUND_RATE_LIMIT_WINDOW_SECONDS=60

RECORDINGS_LOCAL_DIR=/recordings
ASTERISK_RECORDINGS_DIR=/recordings
RECORDINGS_STORAGE_BACKEND=local
RECORDING_RETENTION_DAYS=90
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PREFIX=sip-call-recordings
ALIYUN_OSS_SIGNED_URL_EXPIRE_SECONDS=300
